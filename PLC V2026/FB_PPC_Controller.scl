FUNCTION_BLOCK "FB_PPC_Controller"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
// =============================================================================
// FB_PPC_Controller  â€”  Plant Power Controller, main block
// -----------------------------------------------------------------------------
// PURPOSE:
//   Orchestrates the entire PPC control loop. Called from OB30 (cyclic interrupt,
//   default 100 ms). Calls eight FCs/FBs in a fixed order; each feeds the next.
//
// CALL ORDER AND DATA FLOW:
//   â‘   FC_PPC_InverterMonitor    â†’  N_Online, PmaxPlant, QmaxPlant, Inverters[i].Available
//   â‘¡  FC_PPC_ModeManager        â†’  Plant_Mode  (LOCAL / REMOTE_IEC / FALLBACK)
//   â‘¢  FC_PPC_RampControl        â†’  Ramps_Pcmd  (rate-limited P command from Cmd_P)
//   â‘£  FB_PPC_FreqResponse       â†’  P_final_kW  (droop correction added POST-ramp;
//                                     if Trip_FreqFault: P_final_kW = 0 AND Ramps_Pcmd reset)
//   â‘¤  FB_PPC_QCapability        â†’  Q_final_kVAr  (P-Q capability clamp + Q ramp;
//                                     Q_ramp moved here from FC_PPC_ReactiveControl)
//   â‘¥  FC_PPC_PowerDistribution  â†’  WSpt, WMode per inverter (receives P_final_kW)
//   â‘¦  FC_PPC_ReactiveControl    â†’  VArSpt / PFSpt / VArMode per inverter
//                                     (receives Q_final_kVAr; Q ramp stripped out)
//   â‘§  FC_PPC_FaultHandler       â†’  OperMode overrides; AnyFault, AnyDerating, FaultMask
//
// PRECONDITION â€” caller (OB30) must run BEFORE this FB (single call):
//   "FC_SkidElectricStatus"(
//       Skid1  := "FB_PPC_Controller_DB".Skids[0],
//       Skid2  := "FB_PPC_Controller_DB".Skids[1],
//       ...
//       Skid10 := "FB_PPC_Controller_DB".Skids[9]
//   );
//   Skids[] lives in this FB's instance DB (FB_PPC_Controller_DB), NOT in the
//   global "PPC_Controller" DB (DB39). Replace "FB_PPC_Controller_DB" with
//   whatever name was assigned to this FB's IDB in TIA Portal if different.
//   DI tags (e.g. "Skid1_sep_cel_1") are read directly from the Default tag
//   table inside FC_SkidElectricStatus â€” no wiring needed at the call site.
//   Skids lives in the PPC_Controller instance DB (static section below) â€”
//   no separate SKID_ELECTRIC global DB is required.
//
// FREQUENCY DROOP ARCHITECTURE (Art. 114â€“120, ANRE Ord 51/2019):
//   Droop correction is added AFTER the P ramp (step â‘¢â†’â‘£) so frequency events
//   bypass rate limiting â€” primary frequency response is never ramp-capped.
//   RampControl only limits normal AGC setpoint changes. When Trip_FreqFault:
//   P_final_kW = 0 AND Ramps_Pcmd is reset so reconnect ramp-up starts from zero.
//
// Q RAMP RELOCATION:
//   Ramps_Qcmd is no longer a static variable in this FB.
//   It lives inside FreqResp_IDB / QCap_IDB.Ramps_Qcmd (FB_PPC_QCapability static).
//   Reset it via QCap_IDB.Ramps_Qcmd := 0.0 when needed (EN_PPC=FALSE, FALLBACKâ†’REMOTE).
//
// DB39 FIELDS REQUIRED (user must add if not present):
//   // FreqResponse parameters (all SCADA-writable):
//   f_nom          : REAL  := 50.0    â€” nominal frequency
//   Pn_MW          : REAL  := 48.0    â€” plant nominal power in MW
//   Droop_OF_pct   : REAL  := 8.0     â€” OF droop % (Art. 114-115)
//   Droop_UF_pct   : REAL  := 10.0    â€” UF droop % (Art. 118-120)
//   DeadBand_mHz   : REAL  := 200.0   â€” dead band in mHz (0 for Art.117 sub-test)
//   Pmin_stab      : REAL  := 0.0     â€” minimum stable power in kW
//   OFRT_Trip_Hz   : REAL  := 51.5    â€” over-frequency trip threshold Hz
//   UFRT_Trip_Hz   : REAL  := 47.5    â€” under-frequency trip threshold Hz
//   Reconnect_Enable : BOOL           â€” rising edge clears freq trip latch
//   // FreqResponse diagnostics (SCADA-readable):
//   dP_droop        : REAL â€” droop correction term kW (ISCE acquisition)
//   FreqResp_Pmin   : REAL â€” dynamic Pmin_active kW
//   FreqResp_Pmax   : REAL â€” dynamic Pmax_active kW
//   Trip_FreqFault  : BOOL â€” frequency trip active
//   Reconnecting    : BOOL â€” recovering from trip
//   Reconnect_Timer_s : REAL â€” reconnect duration seconds (ISCE Test 7)
//   // QCapability parameters (all SCADA-writable):
//   VArControl_Mode  : INT  := 0     â€” 0=fixed Q, 1=U droop, 2=off
//   U_setpoint_ext   : REAL          â€” kV, voltage setpoint for U droop mode
//   U_Droop_pct      : REAL := 5.0   â€” % voltage droop
//   Q_Ramp_Rate_fast : REAL          â€” kVAr/s fast ramp (ISCE Test 6)
//   Q_Ramp_Rate_slow : REAL          â€” kVAr/s slow ramp (ISCE Test 6)
//   Q_Ramp_Fast_Sel  : BOOL          â€” FALSE=slow, TRUE=fast
//   // QCapability parameters (cont.):
//   U_nom_kV         : REAL := 110.0 â€” POC nominal voltage kV (for U_pu = U_meas / U_nom_kV)
//   // QCapability diagnostics (SCADA-readable):
//   Q_max_inductive  : REAL â€” current Q inductive limit kVAr (ISCE Test 8)
//   Q_max_capacitive : REAL â€” current Q capacitive limit kVAr (ISCE Test 8)
//   Q_limited        : BOOL â€” Q was clamped by ANRE P-Q capability envelope (Stage 1)
//   SMA_Qmax_plant   : REAL â€” SMA physical Q limit for plant at current P/U (Stage 2)
//   Q_SMA_limited    : BOOL â€” Q was clamped by SMA physical envelope (Stage 2)
//
// LOCAL MODE:
//   When Plant_Mode = 0 (LOCAL), the OB30 caller is responsible for supplying
//   Cmd_P and Cmd_Q from the HMI DB rather than from the SCADA comms thread.
//
// FALLBACK RECOVERY (S4 fix):
//   When Plant_Mode transitions from FALLBACK (2) to REMOTE_IEC (1), Ramps_Pcmd
//   and QCap_IDB.Ramps_Qcmd are forced to 0 for a clean ramp-up from zero.
//
// CALLED FROM: OB30 (cyclic, 100 ms)
// INSTANCE DB:  assign one DB when placing the FB call in OB30
// =============================================================================
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// INPUTS  (set by the OB30 network that calls this FB)
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
   VAR_INPUT 
      EN_PPC : Bool;   // Heartbeat bit from the upstream Modbus/IEC comms thread. Must toggle (0â†’1 edge) at least once per Watchdog_Timeout period.
      IEC_Watchdog : Bool;   // OB30 cycle time in seconds. Default: 0.1 (100 ms).
      CycleTime_s : Real;   // Active power target from upstream SCADA / grid operator, in kW. In LOCAL mode: supplied by OB30 caller from HMI DB.
      Cmd_P : Real;   // Reactive power target in kVAr. Used when Cmd_VArMode = 1 and VArControl_Mode = 0. In LOCAL mode: supplied by OB30 caller from HMI DB.
      Cmd_Q : Real;   // Power factor target (e.g. 0.95, 1.00). Used when Cmd_VArMode = 2.
      Cmd_PF : Real;   // Reactive control mode: 0 = Off, 1 = Q dispatch, 2 = PF setpoint. Controls FC_PPC_ReactiveControl. Q source (fixed vs U-droop) is set via "PPC_Controller".VArControl_Mode which feeds FB_PPC_QCapability.
      Cmd_VArMode : Int;   // TRUE when HMI LOCAL/REMOTE selector is in LOCAL.
      LocalMode_Req : Bool;   // Hz, grid-measured frequency from analog input. Active frequency source when Frequency_Source_Sel = FALSE.
      f_meas : Real;   // Hz, ISCE test bench frequency (4â€“20 mA AI, mapped 47.5â€“52.0 Hz). Active frequency source when Frequency_Source_Sel = TRUE.
      Freq_Test_Override : Real;   // FALSE = use f_meas (normal operation); TRUE = use Freq_Test_Override (ISCE window). Must be SCADA-writable so commissioning team can switch without a code change.
      Frequency_Source_Sel : Bool;   // kV, MV busbar measured voltage from grid meter or VT on MV bus. Used by FB_PPC_QCapability in voltage droop mode (VArControl_Mode = 1).
      U_meas : Real;   // kW, plant actual active power from grid meter (measurement, not setpoint). Used by FB_PPC_QCapability to index into the P-Q capability table.
      P_actual_kW : Real;   // Simulation mode â€” bypasses all hardware-state checks so the PPC logic (setpoints, ramps, droop, Q capability, mode management) can be tested without physical inverters or switchgear connected. When TRUE, every inverter is forced to: RemReady=TRUE, CommError=FALSE, Error=FALSE, PwrOffReas=0, DrtStt=0, WAval=10000 (100% pu), VArAval=10000; and all Skids[i].ELECTRIC_OK=TRUE. Enabled is NOT forced â€” set it via watch table to simulate different fleet sizes (e.g. disable inverters 6-10 to test 5-unit distribution). ForceStop (EN_PPC=FALSE) and FALLBACK still stop the plant normally.
      Sim_Mode : Bool;   // â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ OUTPUTS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ TRUE when Plant_Mode = 1 (REMOTE_IEC) â€” controller active.
      // [ADDED MOD_POC_PF] POC measurements for Mode 4 PI control
      P_poc_kW   : Real;   // kW, active power at POC from grid meter (wired in OB30)
      Q_poc_kVAr : Real;   // kVAr, reactive power at POC from grid meter
                            //   positive = plant absorbing (inductive), negative = plant injecting (capacitive)
   END_VAR

   VAR_OUTPUT 
      PPC_Active : Bool;   // TRUE when any inverter has an active fault, comms error, or PwrOffReas â‰  0.
      PPC_Fault : Bool;   // TRUE when any healthy inverter reports a non-zero derating state.
      AnyDerating : Bool;   // Current Plant_Mode (0/1/2). For HMI display.
      Mode_Out : Int;   // â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ STATIC  (retained between OB30 cycles) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
   END_VAR

   VAR 
      Watchdog_TON {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;
      Watchdog_LastBit : Bool;
      Watchdog_Timeout : Time := T#30S;
      Plant_Mode : Int;
      Ramps_Pcmd : Real;   // NOTE: Ramps_Qcmd is NO LONGER here â€” it lives in QCap_IDB.Ramps_Qcmd.       Reset it via QCap_IDB.Ramps_Qcmd := 0.0 when a clean restart is needed. Previous Plant_Mode â€” used to detect FALLBACKâ†’REMOTE_IEC transition (S4).
      PrevMode : Int;   // Previous Error state per inverter â€” for ErrClr one-shot edge detection (S3.3).
      PrevError_Arr : Array[0..9] of Bool;   // Previous Enabled state per inverter â€” for ErrClr re-send on re-enable (M6).
      PrevEnabled_Arr : Array[0..9] of Bool;   // Switchgear electric status â€” written by FC_SkidElectricStatus calls in OB30 via "FB_PPC_Controller_DB".Skids[0..9]. Lives here (not in global DB39) so no separate global DB is needed. Passed to FC_PPC_InverterMonitor as SkidElectric.
      Skids : Array[0..9] of "Skid_Electric_Status";   // Multi-instance FBs â€” instance data stored within this FB's own IDB.
      FreqResp_IDB : "FB_PPC_FreqResponse";   // step â‘£: P-f droop, OFRT/UFRT trip
      QCap_IDB : "FB_PPC_QCapability";   // step â‘¤: P-Q capability + Q ramp â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ TEMP  (recalculated each OB30 cycle) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
   END_VAR

   VAR_TEMP 
      WD_EdgeDetected : Bool;
      WD_Expired : Bool;
      N_Online : Int;
      PmaxPlant : Real;
      QmaxPlant : Real;
      AnyFault_Tmp : Bool;
      FaultMask : Word;
      P_final_kW : Real;   // kW, after droop correction (FreqResp output â†’ PowerDist input)
      Q_final_kVAr : Real;   // kVAr, after P-Q clamp (QCap output â†’ ReactiveCtrl input)
      i_sim : Int;   // loop index for Sim_Mode override
      U_pu : Real;   // grid voltage in per-unit (U_meas / U_nom_kV) â†’ SMA envelope lookup
   END_VAR


BEGIN
	
	
	    // =========================================================================
	    // GUARD: PPC disabled (EN_PPC = FALSE)
	    // =========================================================================
	    IF NOT #EN_PPC THEN
	        "FC_PPC_FaultHandler"(
	            Plant_Mode   := #Plant_Mode,
	            ForceStop    := TRUE,
	            Inverters    := "PPC_Controller".Inverters.PPC_Inverters,
	            Ramps_Pcmd   := #Ramps_Pcmd,
	            Ramps_Qcmd   := #QCap_IDB.Ramps_Qcmd,
	            PrevError    := #PrevError_Arr,
	            PrevEnabled  := #PrevEnabled_Arr,
	            AnyFault     => #AnyFault_Tmp,
	            AnyDerating  => #AnyDerating,
	            FaultMask    => #FaultMask
	        );
	        #Plant_Mode             := 0;
	        #Ramps_Pcmd             := 0.0;
	        #QCap_IDB.Ramps_Qcmd   := 0.0;   // Q ramp reset (lives in QCap multi-instance IDB)
	        #FreqResp_IDB.Trip_Latch := FALSE;  // Clear freq trip on disable (clean re-enable)
	        #PrevMode               := 0;
	        // Write outputs
	        #PPC_Active  := FALSE;
	        #PPC_Fault   := #AnyFault_Tmp;
	        #Mode_Out    := 0;
	        // Mirror to DB
	        "PPC_Controller".Plant_Mode   := 0;
	        "PPC_Controller".Ramps_Pcmd   := 0.0;
	        "PPC_Controller".Ramps_Qcmd   := 0.0;
	        "PPC_Controller".AnyFault     := #AnyFault_Tmp;
	        "PPC_Controller".AnyDerating  := #AnyDerating;
	        "PPC_Controller".FaultMask    := #FaultMask;
	        RETURN;
	    END_IF;
	
	
	    // =========================================================================
	    // WATCHDOG â€” Rising-edge detection and TON timer management
	    // =========================================================================
	    #WD_EdgeDetected  := #IEC_Watchdog AND NOT #Watchdog_LastBit;
	    #Watchdog_LastBit := #IEC_Watchdog;
	
	    IF #WD_EdgeDetected THEN
	        #Watchdog_TON(IN := FALSE, PT := #Watchdog_Timeout);
	    ELSE
	        #Watchdog_TON(IN := TRUE,  PT := #Watchdog_Timeout);
	    END_IF;
	
	    #WD_Expired := #Watchdog_TON.Q AND NOT #Sim_Mode;
	
	
	    // =========================================================================
	    // SIMULATION MODE â€” force all hardware-state fields to healthy values
	    // =========================================================================
	    // Runs BEFORE InverterMonitor so the forced values flow through every
	    // downstream FC unchanged. ForceStop and FALLBACK are not overridden.
	    //
	    // Enabled is NOT forced â€” write it freely via watch table / SCADA to
	    // simulate different fleet sizes (e.g. set inverters 6-10 Enabled=FALSE
	    // to test 5-inverter power distribution). All other health fields are
	    // forced healthy so any Enabled inverter is guaranteed Available with
	    // full capacity. Non-Enabled inverters are skipped by InverterMonitor
	    // and N_Online drops accordingly.
	    //
	    // After first download with Sim_Mode=TRUE: set desired inverters
	    // Enabled=TRUE via watch table before starting the test.
	    IF #Sim_Mode THEN
	        FOR #i_sim := 0 TO 9 DO
	            // Enabled intentionally not forced â€” operator-controlled
	            "PPC_Controller".Inverters.PPC_Inverters[#i_sim].RemReady   := TRUE;
	            "PPC_Controller".Inverters.PPC_Inverters[#i_sim].CommError  := FALSE;
	            "PPC_Controller".Inverters.PPC_Inverters[#i_sim].Error      := FALSE;
	            "PPC_Controller".Inverters.PPC_Inverters[#i_sim].PwrOffReas := 0;
	            "PPC_Controller".Inverters.PPC_Inverters[#i_sim].DrtStt     := 0;
	            "PPC_Controller".Inverters.PPC_Inverters[#i_sim].WAval      := 10000; // 100% FIX4
	            "PPC_Controller".Inverters.PPC_Inverters[#i_sim].VArAval    := 10000; // 100% FIX4
	            #Skids[#i_sim].ELECTRIC_OK := TRUE;
	        END_FOR;
	    END_IF;
	
	    // =========================================================================
	    // â‘   FC_PPC_InverterMonitor
	    // =========================================================================
	    "FC_PPC_InverterMonitor"(
	        WRtg_kW      := "PPC_Controller".WRtg_kW,
	        Inverters    := "PPC_Controller".Inverters.PPC_Inverters,
	        SkidElectric := #Skids,
	        N_Online     => #N_Online,
	        PmaxPlant    => #PmaxPlant,
	        QmaxPlant    => #QmaxPlant
	    );
	    "PPC_Controller".Plant_N_Online   := #N_Online;
	    "PPC_Controller".Limits_PmaxPlant := #PmaxPlant;
	    "PPC_Controller".Limits_QmaxPlant := #QmaxPlant;
	
	
	    // =========================================================================
	    // â‘¡  FC_PPC_ModeManager
	    // =========================================================================
	    "FC_PPC_ModeManager"(
	        WD_Expired    := #WD_Expired,
	        LocalMode_Req := #LocalMode_Req,
	        Plant_Mode    := #Plant_Mode
	    );
	    "PPC_Controller".Plant_Mode := #Plant_Mode;
	
	    // â”€â”€ S4: Reset ramps on FALLBACK â†’ REMOTE_IEC transition â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
	    IF (#PrevMode = 2) AND (#Plant_Mode <> 2) THEN
	        #Ramps_Pcmd           := 0.0;
	        #QCap_IDB.Ramps_Qcmd := 0.0;
	    END_IF;
	    #PrevMode := #Plant_Mode;
	
	
	    // =========================================================================
	    // â‘¢  FC_PPC_RampControl  (limits rate of change of AGC Cmd_P only)
	    // =========================================================================
	    "FC_PPC_RampControl"(
	        Targets_P   := #Cmd_P,
	        PmaxPlant   := #PmaxPlant,
	        P_RampUp    := "PPC_Controller".P_RampUp,
	        P_RampDown  := "PPC_Controller".P_RampDown,
	        CycleTime_s := #CycleTime_s,
	        Plant_Mode  := #Plant_Mode,
	        Ramps_Pcmd  := #Ramps_Pcmd
	    );
	    "PPC_Controller".Ramps_Pcmd := #Ramps_Pcmd;
	
	
	    // =========================================================================
	    // â‘£  FB_PPC_FreqResponse  (P-f droop â€” adds correction POST-ramp)
	    // =========================================================================
	    // Droop correction is applied after RampControl so frequency events are
	    // immediate â€” primary frequency response is never rate-limited by ramp.
	    #FreqResp_IDB(
	        f_meas               := #f_meas,
	        Freq_Test_Override   := #Freq_Test_Override,
	        Frequency_Source_Sel := #Frequency_Source_Sel,
	        f_nom                := "PPC_Controller".f_nom,
	        Pn_MW                := "PPC_Controller".Pn_MW,
	        Droop_OF_pct         := "PPC_Controller".Droop_OF_pct,
	        Droop_UF_pct         := "PPC_Controller".Droop_UF_pct,
	        DeadBand_mHz         := "PPC_Controller".DeadBand_mHz,
	        P_setpoint_ext       := #Ramps_Pcmd,
	        Pmin_stab            := "PPC_Controller".Pmin_stab,
	        Pmax_disp            := #PmaxPlant,
	        OFRT_Trip_Hz         := "PPC_Controller".OFRT_Trip_Hz,
	        UFRT_Trip_Hz         := "PPC_Controller".UFRT_Trip_Hz,
	        Reconnect_Enable     := "PPC_Controller".Reconnect_Enable,
	        Plant_Mode           := #Plant_Mode
	    );
	    #P_final_kW := #FreqResp_IDB.P_setpoint_final;
	
	    // When trip active: also reset P ramp accumulator so recovery starts from 0.
	    // Next cycle RampControl will ramp Ramps_Pcmd up from 0 toward Cmd_P.
	    IF #FreqResp_IDB.Trip_FreqFault THEN
	        #Ramps_Pcmd := 0.0;
	    END_IF;
	
	    // Mirror FreqResponse diagnostics to DB (ISCE acquisition + HMI)
	    "PPC_Controller".P_setpoint_final  := #P_final_kW;
	    "PPC_Controller".dP_droop          := #FreqResp_IDB.dP_droop;
	    "PPC_Controller".FreqResp_Pmin     := #FreqResp_IDB.Pmin_active;
	    "PPC_Controller".FreqResp_Pmax     := #FreqResp_IDB.Pmax_active;
	    "PPC_Controller".Trip_FreqFault    := #FreqResp_IDB.Trip_FreqFault;
	    "PPC_Controller".Reconnecting      := #FreqResp_IDB.Reconnecting;
	    "PPC_Controller".Reconnect_Timer_s := #FreqResp_IDB.Reconnect_Timer_s;
	
	
	    // =========================================================================
	    // â‘¤  FB_PPC_QCapability  (P-Q envelope + Q ramp)
	    // =========================================================================
	    // Control_Mode (0=fixed Q, 1=U droop, 2=off, 3=U control PID) is separate from
	    // Plant_VArMode (0=Off, 1=Q dispatch, 2=PF). A caller can set Plant_VArMode=1
	    // and choose the Q source by setting "PPC_Controller".VArControl_Mode = 0/1/3.
	    // U_pu: per-unit voltage used by Stage 2 SMA envelope lookup.
	    IF "PPC_Controller".U_nom_kV > 0.0 THEN
	        #U_pu := #U_meas / "PPC_Controller".U_nom_kV;
	    ELSE
	        #U_pu := 1.0;
	    END_IF;
	
	    #QCap_IDB(
	        P_actual_kW      := #P_actual_kW,
	        P_setpoint_kW    := #P_final_kW,
	        Pmax_kW          := "PPC_Controller".Pn_MW * 1000.0,
	        Q_setpoint_ext   := #Cmd_Q,
	        U_setpoint_ext   := "PPC_Controller".U_setpoint_ext,
	        U_meas           := #U_meas,
	        Control_Mode     := "PPC_Controller".VArControl_Mode,
	        U_Droop_pct      := "PPC_Controller".U_Droop_pct,
	        Q_Ramp_Rate_fast := "PPC_Controller".Q_Ramp_Rate_fast,
	        Q_Ramp_Rate_slow := "PPC_Controller".Q_Ramp_Rate_slow,
	        Q_Ramp_Fast_Sel  := "PPC_Controller".Q_Ramp_Fast_Sel,
	        QmaxPlant        := #QmaxPlant,
	        CycleTime_s      := #CycleTime_s,
	        Plant_Mode       := #Plant_Mode,
	        N_Online         := #N_Online,
	        U_pu             := #U_pu,
	        U_Kp             := "PPC_Controller".U_Kp,
	        U_Ki             := "PPC_Controller".U_Ki,
	        U_Kd             := "PPC_Controller".U_Kd,
	        U_Kd_Tfilt       := "PPC_Controller".U_Kd_Tfilt,
	        U_deadband_kV    := "PPC_Controller".U_deadband_kV,
	        U_Tt             := "PPC_Controller".U_Tt,
	        PID_Reset        := "PPC_Controller".PID_Reset,
	        P_poc_kW      := #P_poc_kW,           // [ADDED MOD_POC_PF]
	        Q_poc_kVAr    := #Q_poc_kVAr,         // [ADDED MOD_POC_PF]
	        PF_poc_target := "PPC_Controller".PF_poc_target,   // [ADDED MOD_POC_PF]
	        PF_Kp         := "PPC_Controller".PF_Kp,           // [ADDED MOD_POC_PF]
	        PF_Ki         := "PPC_Controller".PF_Ki,           // [ADDED MOD_POC_PF]
	        PF_Tt         := "PPC_Controller".PF_Tt,           // [ADDED MOD_POC_PF]
	        PF_Reset      := "PPC_Controller".PF_Reset         // [ADDED MOD_POC_PF]
	    );
	    #Q_final_kVAr := #QCap_IDB.Q_setpoint_final;
	    "PPC_Controller".PID_Reset := FALSE;   // clear one-shot after FB has processed it
	    // [ADDED MOD_POC_PF] Mode 4 POC PF diagnostics
	    "PPC_Controller".Q_poc_required := #QCap_IDB.Q_poc_required;
	    "PPC_Controller".Q_poc_error    := #QCap_IDB.Q_poc_error;
	    "PPC_Controller".PF_poc_actual  := #QCap_IDB.PF_poc_actual;
	    "PPC_Controller".PF_Reset       := FALSE;   // clear one-shot after FB processed it   // [ADDED MOD_POC_PF]
	
	    // Mirror QCapability diagnostics to DB (ISCE Test 8/9 acquisition + HMI)
	    "PPC_Controller".Q_max_inductive  := #QCap_IDB.Q_max_inductive;
	    "PPC_Controller".Q_max_capacitive := #QCap_IDB.Q_max_capacitive;
	    "PPC_Controller".Q_limited        := #QCap_IDB.Q_limited;
	    "PPC_Controller".Ramps_Qcmd       := #QCap_IDB.Ramps_Qcmd;
	    "PPC_Controller".Q_setpoint_final := #QCap_IDB.Q_setpoint_final;
	    "PPC_Controller".SMA_Qmax_plant   := #QCap_IDB.SMA_Qmax_plant;
	    "PPC_Controller".Q_SMA_limited    := #QCap_IDB.Q_SMA_limited;
	    "PPC_Controller".U_error_kV       := #QCap_IDB.U_error_kV;
	    "PPC_Controller".PID_I_term       := #QCap_IDB.PID_I_term;
	    "PPC_Controller".PID_saturated    := #QCap_IDB.PID_saturated;
	    "PPC_Controller".PID_active       := #QCap_IDB.PID_active;
	
	
	    // =========================================================================
	    // â‘¥  FC_PPC_PowerDistribution  (receives P_final_kW after droop correction)
	    // =========================================================================
	    "FC_PPC_PowerDistribution"(
	        Ramps_Pcmd := #P_final_kW,   // droop-corrected P command (not raw Ramps_Pcmd)
	        Plant_Mode := #Plant_Mode,
	        WRtg_kW    := "PPC_Controller".WRtg_kW,
	        Inverters  := "PPC_Controller".Inverters.PPC_Inverters
	    );
	
	
	    // =========================================================================
	    // â‘¦  FC_PPC_ReactiveControl  (receives Q_final_kVAr â€” Q ramp already done)
	    // =========================================================================
	    "FC_PPC_ReactiveControl"(
	        Plant_VArMode := #Cmd_VArMode,
	        Q_cmd_kVAr    := #Q_final_kVAr,   // ramped + capability-clamped Q from QCapability
	        Targets_PF    := #Cmd_PF,
	        Plant_Mode    := #Plant_Mode,
	        Sim_Mode      := #Sim_Mode,
	        U_pu          := #U_pu,
	        Inverters     := "PPC_Controller".Inverters.PPC_Inverters
	    );
	
	
	    // =========================================================================
	    // â‘§  FC_PPC_FaultHandler  (always last)
	    // =========================================================================
	    "FC_PPC_FaultHandler"(
	        Plant_Mode   := #Plant_Mode,
	        ForceStop    := FALSE,
	        Inverters    := "PPC_Controller".Inverters.PPC_Inverters,
	        Ramps_Pcmd   := #Ramps_Pcmd,
	        Ramps_Qcmd   := #QCap_IDB.Ramps_Qcmd,
	        PrevError    := #PrevError_Arr,
	        PrevEnabled  := #PrevEnabled_Arr,
	        AnyFault     => #AnyFault_Tmp,
	        AnyDerating  => #AnyDerating,
	        FaultMask    => #FaultMask
	    );
	    "PPC_Controller".AnyFault    := #AnyFault_Tmp;
	    "PPC_Controller".AnyDerating := #AnyDerating;
	    "PPC_Controller".FaultMask   := #FaultMask;
	
	
	    // =========================================================================
	    // OUTPUT ASSIGNMENTS
	    // =========================================================================
	    #Mode_Out   := #Plant_Mode;
	    #PPC_Active := (#Plant_Mode <> 2);
	    #PPC_Fault  := #AnyFault_Tmp;
	
	
END_FUNCTION_BLOCK

